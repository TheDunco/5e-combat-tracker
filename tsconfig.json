{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
        "@components/*": [
            "Components/*",
        ],
        "@ui/*": [
            "Components/UI/*",
        ],
        "@store": [
            "useStateStore"
        ],
        "@types": [
            "types"
        ]
    }
  },
  "include": [
    "app"
  ],
  "exclude": ["node_modules", ".vinxi"]
}
